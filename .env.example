# ==============================================================================
# sgsm-ia — variaveis de ambiente por profile (dev / hom / prd)
# Copie para .env e preencha com valores reais. NUNCA commitar o .env real.
# ==============================================================================

# ------------------------------------------------------------------------------
# DEV — datasource/redis/milvus/jwt sao valores fixos em application-dev.yaml.
# Ollama ja usa ${VAR:default} de forma consistente com hom/prd.
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?stringtype=unspecified
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
MILVUS_HOST=localhost
MILVUS_PORT=19530
JWT_SECRET=sgsm-chave-desenvolvimento-local-minimo-256-bits-nao-usar-em-producao
# nota-clinica-key em dev e literal (nao ${}) - nome via relaxed binding e
# IA_CRYPTO_NOTA_CLINICA_KEY, NAO o mesmo nome usado em hom/prd (ver abaixo).
IA_CRYPTO_NOTA_CLINICA_KEY=darxrcnm1j5yKMNibgwR9915HT35fzjyaZMP8rBGKt0=
# Segredo compartilhado com o ms-whatsapp-bot (header X-Service-Key em /ia/whatsapp/**).
# Em dev e literal em application-dev.yaml - nome via relaxed binding: IA_WHATSAPP_SERVICE_KEY.
# Precisa ser IGUAL ao sgsm-ia.service-key do ms-whatsapp-bot.
IA_WHATSAPP_SERVICE_KEY=sgsm-whatsapp-service-key-dev
# Rate limit das rotas que chamam o LLM (janela de 1 min no Redis). Opcionais - padrao 20 e 120.
# IA_RATE_LIMIT_CHAT_POR_MINUTO=20
# IA_RATE_LIMIT_WHATSAPP_POR_MINUTO=120
# JWT: o token precisa ter iss=sgsm-auth e "sgsm-ia" no aud (emitidos pelo ms-sboot-auth).
# Opcionais - so mudar se o ms-sboot-auth mudar o emissor/audiencias.
# JWT_ISSUER=sgsm-auth
# JWT_AUDIENCIA=sgsm-ia
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ------------------------------------------------------------------------------
# HOM — application-hom.yaml ja usa ${VAR} em todos os campos abaixo.
# Continua usando Ollama (nao OpenAI) em hom, igual dev.
# ------------------------------------------------------------------------------
# DATASOURCE_URL=
# DATASOURCE_USERNAME=
# DATASOURCE_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# MILVUS_HOST=
# MILVUS_PORT=19530
# JWT_SECRET=
# NOTA_CLINICA_CRYPTO_KEY=
# WHATSAPP_SERVICE_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_CHAT_MODEL=deepseek-r1:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# TRACING_SAMPLING_PROBABILITY=1.0
# ZIPKIN_ENDPOINT=

# ------------------------------------------------------------------------------
# PRD — troca de provider: OpenAI em vez de Ollama.
# ATENCAO: ha uma decisao pendente sobre usar Anthropic em vez de OpenAI aqui -
# ver Plano_Implantacao_VPS_SGSM.docx, secao 4.3. Se mudar de provider, os nomes
# de variavel abaixo tambem mudam (langchain4j.open-ai -> outro bloco de config).
# ------------------------------------------------------------------------------
# DATASOURCE_URL=
# DATASOURCE_USERNAME=
# DATASOURCE_PASSWORD=
# REDIS_HOST=
# REDIS_PORT=6379
# MILVUS_HOST=
# MILVUS_PORT=19530
# JWT_SECRET=
# NOTA_CLINICA_CRYPTO_KEY=
# WHATSAPP_SERVICE_KEY=
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# TRACING_SAMPLING_PROBABILITY=0.1
# ZIPKIN_ENDPOINT=
